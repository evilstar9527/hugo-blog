{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Data.Pages }}
  {{ $priority := .Sitemap.Priority }}
  {{ $changefreq := .Sitemap.ChangeFreq }}
  {{ if .IsHome }}
    {{ $priority = 1.0 }}
    {{ $changefreq = "weekly" }}
  {{ else if eq .Kind "section" }}
    {{ $priority = 0.8 }}
    {{ $changefreq = "weekly" }}
  {{ else if eq .Type "posts" }}
    {{ $priority = 0.7 }}
    {{ $changefreq = "monthly" }}
  {{ else if or (eq .Kind "taxonomy") (eq .Kind "term") }}
    {{ $priority = 0.5 }}
    {{ $changefreq = "monthly" }}
  {{ else }}
    {{ if lt $priority 0.0 }}{{ $priority = 0.5 }}{{ end }}
    {{ if not $changefreq }}{{ $changefreq = "monthly" }}{{ end }}
  {{ end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{ if not .Lastmod.IsZero }}<lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}
    {{ with $changefreq }}<changefreq>{{ . }}</changefreq>{{ end }}
    <priority>{{ $priority }}</priority>
    {{ if .IsTranslated }}{{ range .Translations }}
    <xhtml:link
                rel="alternate"
                hreflang="{{ .Lang }}"
                href="{{ .Permalink }}"
                />
    {{ end }}{{ end }}
  </url>
  {{ end }}
</urlset>
